{
  "entities": {
    "SiteBranding": {
      "title": "SiteBranding",
      "description": "Global branding configuration, logos, hero images, and team avatars",
      "type": "object",
      "properties": {
        "headerLogoUrl": { "type": "string" },
        "headerLogoHeight": { "type": "number" },
        "footerLogoUrl": { "type": "string" },
        "footerLogoHeight": { "type": "number" },
        "heroImageUrl": { "type": "string" },
        "heroOverlayOpacity": { "type": "number" },
        "aboutHeroImageUrl": { "type": "string" },
        "aboutFactoryImageUrl": { "type": "string" },
        "aboutLeadershipAvatars": { "type": "object" },
        "aboutAdvisoryAvatars": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "MediaItem": {
      "title": "MediaItem",
      "description": "Uploaded media library items and images",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "size": { "type": "string" },
        "dimensions": { "type": "string" },
        "uploadedAt": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "name", "url"]
    },
    "ProjectCaseStudy": {
      "title": "ProjectCaseStudy",
      "description": "Civil and industrial concrete project case studies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "sector": { "type": "string" },
        "location": { "type": "string" },
        "client": { "type": "string" },
        "area": { "type": "string" },
        "fiberType": { "type": "string" },
        "dosage": { "type": "string" },
        "concreteVolume": { "type": "string" },
        "co2Savings": { "type": "string" },
        "year": { "type": "string" },
        "summary": { "type": "string" },
        "image": { "type": "string" },
        "featured": { "type": "boolean" }
      },
      "required": ["id", "title"]
    },
    "ConsultationRequest": {
      "title": "ConsultationRequest",
      "description": "Inbound technical inquiries and engineering consultation requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "firm": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "projectType": { "type": "string" },
        "slabArea": { "type": "string" },
        "targetDate": { "type": "string" },
        "submittedAt": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["name", "email"]
    }
  },
  "firestore": {
    "/site_config/{configId}": {
      "schema": "SiteBranding",
      "description": "Shared site configuration, hero banners, and branding assets"
    },
    "/media_items/{mediaId}": {
      "schema": "MediaItem",
      "description": "Central media assets uploaded by administrators"
    },
    "/projects/{projectId}": {
      "schema": "ProjectCaseStudy",
      "description": "Real-time project case studies"
    },
    "/consultations/{consultationId}": {
      "schema": "ConsultationRequest",
      "description": "Real-time structural engineering consultation requests"
    }
  }
}
