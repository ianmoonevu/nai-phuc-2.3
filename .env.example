# Frontend / existing optional integrations
GEMINI_API_KEY=""
APP_URL="https://hokimetal.vn"
VITE_WEBHOOK_URL=""

# Production server
NODE_ENV="production"
PORT="3000"

# TENTEN MySQL
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="your_tenten_database"
DB_USER="your_tenten_database_user"
DB_PASSWORD="change-me"
DB_POOL_SIZE="10"

# Admin session - generate a long random secret
SESSION_SECRET="replace-with-a-long-random-secret"

# Initial admin bootstrap.
# On first successful server start, the account is created only if it does not exist.
# After confirming login, remove ADMIN_PASSWORD from the production environment.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Uploaded images are stored here relative to the app root
UPLOAD_DIR="uploads"
