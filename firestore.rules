rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Site Configuration and Global Branding (Hero image, logos, etc.)
    match /site_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Media Library Assets uploaded across devices
    match /media_items/{mediaId} {
      allow read: if true;
      allow write: if true;
    }

    // Real-time Project Case Studies
    match /projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    // Consultation Inquiries and Technical Submissions
    match /consultations/{consultationId} {
      allow read: if true;
      allow write: if true;
    }

    // Technical Monographs & Articles
    match /articles/{articleId} {
      allow read: if true;
      allow write: if true;
    }

    // About Us Page Data and Leadership Configurations
    match /about_info/{infoId} {
      allow read: if true;
      allow write: if true;
    }

    // Strategic Contractor & EPC Partners
    match /epc_partners/{partnerId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
